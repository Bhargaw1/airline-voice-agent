# ==========================================
# AZURE OPENAI (LLM for SQL generation + embeddings for policy RAG)
# ==========================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key
EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_API_VERSION=2024-02-01
CHAT_DEPLOYMENT=gpt-5-mini
CHAT_API_VERSION=2024-12-01-preview

# ==========================================
# AZURE AI SEARCH (policy documents RAG)
# ==========================================
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your-search-admin-key
SEARCH_INDEX_NAME=voice-agent-docs

# ==========================================
# AZURE SQL (flight schedules — table dbo.voice_agent_data)
# ==========================================
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=your_database
SQL_USERNAME=your_sql_user
SQL_PASSWORD=your_sql_password
SQL_DRIVER=ODBC Driver 18 for SQL Server

# ==========================================
# SQL / voice latency (flight search)
# ==========================================
SQL_VOICE_FAST=true
SQL_FLOW_ZERO_ROW_RETRY=false
SQL_LIGHT_SCHEMA=true
FLIGHT_CACHE_TTL_SECONDS=60
SQL_FLOW_REASONING_EFFORT=minimal

# ==========================================
# GOOGLE GEMINI LIVE (real-time voice)
# ==========================================
GEMINI_ENDPOINT=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent
GEMINI_MODEL_NAME=gemini-2.0-flash-exp
GEMINI_API_KEY=your-gemini-api-key
GEMINI_VOICE_NAME=Puck

# ==========================================
# AZURE REDIS (optional semantic cache for policy queries)
# ==========================================
REDIS_HOST=your-redis.redis.azure.net
REDIS_PORT=10000
REDIS_PASSWORD=your-redis-password
REDIS_SSL=true

# ==========================================
# BACKEND API (optional — if set, REST + WS require X-API-Key / ?api_key=)
# ==========================================
BACKEND_API_KEY=

# ==========================================
# SMTP (optional — booking handoff email)
# ==========================================
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-app-password
SMTP_FROM=voice-agent@example.com

# ==========================================
# RUNTIME TUNING (optional)
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_FILE=backend.log
TOOL_TIMEOUT_SECONDS=20.0
SEND_TOOL_EVENTS_TO_CLIENT=false
FLIGHT_UI_DEBUG=false
MAX_CONCURRENT_VOICE_SESSIONS=200
